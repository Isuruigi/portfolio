{
  "name": "axon-avatar-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Face-to-face Axon: a LiveKit agent with an Anam avatar, sharing the site's knowledge base",
  "scripts": {
    "sync": "node scripts/sync-knowledge.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/sync-knowledge.mjs && lk agent dev",
    "start": "node src/main.ts start"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@livekit/agents": "^1.10.0",
    "@livekit/agents-plugin-anam": "^1.10.0",
    "@livekit/agents-plugin-deepgram": "~1.10.1",
    "@livekit/agents-plugin-elevenlabs": "~1.10.1",
    "@livekit/agents-plugin-google": "^1.10.0",
    "@livekit/agents-plugin-silero": "~1.10.1",
    "@livekit/rtc-node": "^1.2.2",
    "dotenv": "^17.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3"
  }
}
