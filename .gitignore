# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend (Python)
backend/.env
backend/__pycache__/
backend/*.pyc
backend/venv/
*.pyc
__pycache__/

# Deployment Guides
backend/*.md

# ElevenLabs voiceover clips (regenerable, cost credits)
scripts/reel/vo/

# Cloudflare local secrets
.dev.vars
.wrangler/

# Original photos used to render the reel (the finished reel is in public/media)
scripts/reel/photos/
